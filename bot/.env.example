BOT_TOKEN=
ADMIN_IDS=
DB_PATH=/opt/imobiliare/data/imobiliare.db
PHOTOS_DIR=/opt/imobiliare/data/photos
DEFAULT_CURRENCY=EUR

# Paid product: Boost = listing pinned first in search for N days, price in Telegram Stars.
# 1 Star ~ 1 cent for the buyer; keep it in the same money range as the other rails.
BOOST_STARS=50
BOOST_DAYS=7

# Rail 2: card/bank transfer in MDL, activated by an admin after the money really arrives.
# Works in Moldova without acquiring contract. 0 = option hidden.
BOOST_MDL=100
# Where to send the money, shown to the buyer, e.g. "карта 5199 0000 0000 0000, maib, Ivan P."
PAY_INFO=

# Rail 3: real Visa/Mastercard via Lemon Squeezy (merchant of record, Moldova is a supported
# payout country). All four values come from the LS dashboard:
#   LS_API_KEY   Settings -> API keys;  LS_STORE_ID  store id in the URL; LS_VARIANT_ID
#   Products -> your product -> variant id;  LS_WEBHOOK_SECRET  Settings -> Webhooks -> secret
# Webhook URL to register in LS: https://<your-https-domain>/webhook/lemonsqueezy
LS_API_KEY=
LS_STORE_ID=
LS_VARIANT_ID=
LS_WEBHOOK_SECRET=
# Boost price on the checkout, in cents of the store currency (500 = $5.00)
CARD_PRICE_CENTS=500

# Revenue loop: DM the owner of a live, non-boosted listing with a Boost offer
NUDGE_AFTER_DAYS=2
NUDGE_COOLDOWN_DAYS=4
NUDGE_INTERVAL_HOURS=6

# Public channel for auto-posting approved listings (@username or -100xxxxxxxxxx id)
CHANNEL_ID=
# Bot username, used for "post your own listing" CTA buttons in channel posts
BOT_USERNAME=
# HTTPS url of the Telegram Mini App, e.g. https://imobil.example.md (empty -> button hidden).
# The same host must be publicly reachable for the LS payment webhook to work.
WEBAPP_URL=
# Optional support contact used by /paysupport
CONTACT_URL=
