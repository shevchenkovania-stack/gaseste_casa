# Deploys are scp of these files onto a Linux box, and a stray \r breaks a bash heredoc or a
# python import with a confusing error. Force LF for everything that ever leaves the repo to the
# server, so "sed -i 's/\r$//'" stays a safety net rather than a requirement.
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.html      text eol=lf
*.txt       text eol=lf
.env.example text eol=lf

*.db   binary
*.png  binary
*.jpg  binary
